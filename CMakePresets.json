{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-debug-sanitize",
      "displayName": "Linux Debug with ASan/UBSan",
      "inherits": "linux-debug",
      "cacheVariables": {
        "TTRALLY_SANITIZE": "ON"
      }
    },
    {
      "name": "ci-linux",
      "displayName": "Linux CI (Release, warnings as errors)",
      "inherits": "linux-release",
      "cacheVariables": {
        "TTRALLY_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release (MSVC)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug (MSVC)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ci-windows",
      "displayName": "Windows CI (Release, warnings as errors)",
      "inherits": "windows-release",
      "cacheVariables": {
        "TTRALLY_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-debug-sanitize",
      "configurePreset": "linux-debug-sanitize"
    },
    {
      "name": "ci-linux",
      "configurePreset": "ci-linux"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows"
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "inherits": "test-base",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-debug",
      "inherits": "test-base",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-debug-sanitize",
      "inherits": "test-base",
      "configurePreset": "linux-debug-sanitize",
      "environment": {
        "LSAN_OPTIONS": "suppressions=${sourceDir}/tests/sanitizer/lsan.supp"
      }
    },
    {
      "name": "ci-linux",
      "inherits": "test-base",
      "configurePreset": "ci-linux"
    },
    {
      "name": "windows-release",
      "inherits": "test-base",
      "configurePreset": "windows-release"
    },
    {
      "name": "windows-debug",
      "inherits": "test-base",
      "configurePreset": "windows-debug"
    },
    {
      "name": "ci-windows",
      "inherits": "test-base",
      "configurePreset": "ci-windows"
    }
  ]
}
