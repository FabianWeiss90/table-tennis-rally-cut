{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "ttrally",
  "version-semver": "0.1.0",
  "description": "Rally detection for table tennis videos from a hobby camera perspective",
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": [
    "cli11",
    "pocketfft",
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swresample",
        "swscale"
      ],
      "platform": "windows"
    }
  ],
  "features": {
    "tests": {
      "description": "Build the unit tests",
      "dependencies": [
        "catch2"
      ]
    },
    "gui": {
      "description": "Build the annotation GUI (Dear ImGui + SDL3)",
      "dependencies": [
        {
          "name": "imgui",
          "features": [
            "sdl3-binding",
            "sdl3-renderer-binding"
          ]
        },
        {
          "name": "sdl3",
          "default-features": false,
          "features": [
            {
              "name": "wayland",
              "platform": "linux"
            },
            {
              "name": "x11",
              "platform": "linux"
            }
          ]
        }
      ]
    }
  },
  "default-features": [
    "gui",
    "tests"
  ],
  "builtin-baseline": "434307da09bc05b2c86996dccc8b2351fc0d5d37"
}
